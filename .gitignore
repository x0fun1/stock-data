# Only the current skill source belongs in GitHub.
/*
!/.gitignore
!/README.md
!/SKILL.md
!/pyproject.toml
!/requirements.txt
!/examples/
!/policies/
!/references/
!/scripts/
!/tests/

__pycache__/
*.py[cod]
runtime/
.pytest_cache/
.pytest-tmp*/
.ruff_cache/
.venv/
.install-tmp/
.pip-cache/
.env
.env.*
.secrets
.workbuddy-ai/
.workbuddy/
**/.gitignore
!/.gitignore
.gitattributes

# Local planning, research notes and credentials stay out of the repository.
/docs/

# Local data, archives and generated databases.
*.parquet
*.arrow
*.feather
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.zip
