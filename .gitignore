# Only the current skill source belongs in GitHub.
/*
!/.gitignore
!/README.md
!/SKILL.md
!/pyproject.toml
!/requirements.txt
!/requirements-kronos.txt
!/requirements-kronos.lock.txt
!/examples/
!/model-assets/
!/policies/
!/references/
!/scripts/
!/tests/
!/vendor/

__pycache__/
*.py[cod]
runtime/
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.venv/
.install-tmp/
.pip-cache/
.env
.env.*
.secrets
.workbuddy-ai/
.workbuddy/
**/.gitignore
!/.gitignore
.gitattributes

# Local planning, research notes and credentials stay out of the repository.
/docs/

# Retired cross-model experiments, wherever an old copy is placed.
model-comparison/
hourly-model-test/
full-hourly-model-test/
input-parity/
walk-forward-baseline/
rolling_baseline.py

# Local data, checkpoints, archives and generated databases.
*.parquet
*.arrow
*.feather
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.zip
*.pth
*.pt
*.safetensors
*.npy
*.npz

model-assets/kronos-small/*/model.safetensors
model-assets/kronos-small/inference.lock

# Upstream examples create these outputs; keep new runs local as well.
/vendor/kronos/webui/prediction_results/
/vendor/kronos/examples/yuce/*_comprehensive_analysis_report.json
/vendor/kronos/examples/yuce/*_optimized_prediction.png
/vendor/kronos/examples/yuce/market_analysis_report.json
